# Copy to .env.local and fill in real values. Never commit real secrets.

# PostHog — same shared PostHog project as the main wetrends.co.uk site,
# tagged per-deployment via NEXT_PUBLIC_SITE_NAME so dashboards can filter
# by "site".
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_api_key_here"
NEXT_PUBLIC_POSTHOG_UI_HOST="https://us.posthog.com"
NEXT_PUBLIC_SITE_NAME="pitch"

# Cloudinary account holding the pitch videos. Public ids live in
# lib/clients.ts; only the cloud name is needed to build delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="l1uyp2mb"

# Where this app is deployed. Read only by the local outreach scripts, which
# are gitignored — they use it to write the links that go into the emails.
NEXT_PUBLIC_PITCH_BASE_URL="https://pitch.wetrends.co.uk"
