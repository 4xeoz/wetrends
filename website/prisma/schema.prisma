datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

// Admin accounts. Auth.js runs with JWT sessions and a Credentials provider
// only, so there is no adapter and no Account/Session/VerificationToken tables.
model User {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String?    @unique
  image     String?
  password  String?
  blogPosts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Brute-force protection for the credentials login flow
model LoginAttempt {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  identifier  String    @unique // normalized (lowercased) email
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  service   String?
  source    String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Structured leads from the public Events enquiry form.
model EventLead {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  eventDate DateTime
  location  String
  eventType String
  duration  String
  media     String
  addOns    String[]
  details   String?
  status    EventLeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

// A confirmed event and the commercial terms shown in its private offer.
model EventJob {
  id                   String          @id @default(auto()) @map("_id") @db.ObjectId
  clientName           String
  clientEmail          String
  clientPhone          String?
  eventTitle           String
  eventType            String
  eventDate            DateTime?
  location             String?
  photographerName     String
  photographerImage    String?
  partnerName          String?
  includedImageCount   Int             @default(10)
  fullGalleryPrice     Int
  retouchingPrice      Int             @default(0)
  extraCoverageMinutes Int             @default(0)
  extraCoveragePrice   Int             @default(0)
  currency             String          @default("gbp")
  selectedPackage      GalleryPackage?
  retouchingSelected   Boolean         @default(false)
  accessVersion        Int             @default(1)
  status               EventJobStatus  @default(DRAFT)
  offerSentAt          DateTime?
  productionStartedAt  DateTime?
  // Folder created in the company Shared Drive for this event's production files.
  driveFolderId        String?

  gallery EventGallery?
  orders  EventOrder[]
  emails  EventEmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GalleryPackage {
  INCLUDED
  FULL
}

enum EventJobStatus {
  DRAFT
  OFFER_SENT
  AWAITING_PAYMENT
  IN_PRODUCTION
  GALLERY_READY
  COMPLETED
  CANCELLED
}

model EventGallery {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  eventJobId  String         @unique @db.ObjectId
  eventJob    EventJob       @relation(fields: [eventJobId], references: [id], onDelete: Cascade)
  status      GalleryStatus  @default(DRAFT)
  publishedAt DateTime?
  assets      GalleryAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
}

model GalleryAsset {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  galleryId        String       @db.ObjectId
  gallery          EventGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title            String
  alt              String
  provider         String       @default("external")
  sourceUrl        String?
  cloudinaryId     String?
  cloudinaryFormat String?
  driveFileId      String?
  driveMimeType    String?
  driveName        String?
  width            Int?
  height           Int?
  sortOrder        Int          @default(0)
  isFeatured       Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventOrder {
  id                      String           @id @default(auto()) @map("_id") @db.ObjectId
  eventJobId              String           @db.ObjectId
  eventJob                EventJob         @relation(fields: [eventJobId], references: [id], onDelete: Cascade)
  type                    EventOrderType
  status                  EventOrderStatus @default(CREATED)
  paymentMethod           String           @default("stripe")
  customerEmail           String
  currency                String           @default("gbp")
  subtotal                Int
  shippingAmount          Int              @default(0)
  total                   Int
  items                   Json
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  shippingAddress         Json?
  paidAt                  DateTime?
  fulfilledAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventOrderType {
  DIGITAL
  PRINT
}

enum EventOrderStatus {
  CREATED
  CHECKOUT_PENDING
  CONFIRMED
  PAID
  PROCESSING
  FULFILLED
  CANCELLED
  FAILED
  REFUNDED
}

model StripeWebhookEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

model EventEmailLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  eventJobId   String   @db.ObjectId
  eventJob     EventJob @relation(fields: [eventJobId], references: [id], onDelete: Cascade)
  kind         String
  recipient    String
  providerId   String?
  status       String
  errorMessage String?

  createdAt DateTime @default(now())
}

model BlogCategory {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogPost {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  featuredImage String?
  featuredImageAlt    String?
  featuredImageKind   String?
  featuredImageCredit String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  views         Int       @default(0)

  metaTitle       String?
  metaDescription String?
  keywords        String[]
  campaign         String?
  contentType      String?
  primaryServiceUrl String?
  sourceUrls       String[] @default([])
  automationStatus String?
  automationRunId  String?
  qualityScore     Int?

  categoryId String?       @db.ObjectId
  category   BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId   String?       @db.ObjectId
  author     User?         @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cinematography & Photography Booking System
model CinemaBooking {
  id      String              @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  phone   String
  date    DateTime
  service CinemaService
  status  CinemaBookingStatus @default(PENDING)
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CinemaService {
  PHOTOS_8 // £35 - 8 photos of choice, 48h delivery
  PHOTOS_10_VIDEO // £45 - 10 photos + short cinematic video, 48h delivery
}

enum CinemaBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// QR Code Tracking System
model QrLink {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  label       String
  destination String
  scans       QrScan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QrScan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  qrLinkId  String   @db.ObjectId
  qrLink    QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  country   String?
  city      String?
  device    String?
  referer   String?
  scannedAt DateTime @default(now())
}
