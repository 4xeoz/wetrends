      "id": "def15d81-f877-45e2-92ce-2c97c84bb9fe",
      "name": "OpenAI Luna - Planner",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        300,
        640
      ],
      "credentials": {
        "openAiApi": {
          "id": "Lrj5HIOGIlIosZun",
          "name": "OpenAI - WeTrends SEO"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json;\n  const raw = String(output.text ?? output.response ?? output.output ?? '[]').replace(/```json/gi, '').replace(/```/g, '').trim();\n  const start = raw.indexOf('[');\n  const end = raw.lastIndexOf(']');\n  if (start < 0 || end <= start) throw new Error('Topic planner did not return a JSON array.');\n  const topics = JSON.parse(raw.slice(start, end + 1));\n  if (!Array.isArray(topics) || topics.length !== 3) throw new Error('Topic planner must return exactly three topics.');\n  return topics.map((topic) => ({ json: { topic: String(topic.topic || '').slice(0, 240), keywords: String(topic.keywords || '').slice(0, 500), icp_angle: String(topic.icp_angle || '').slice(0, 500), intent: String(topic.intent || '').slice(0, 120), status: 'queued_london', published_url: '' } }));"
      },
