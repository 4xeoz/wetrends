        "jsCode": "const post = $input.first().json.post;\n  if (!post || post.contentType === 'case_study') throw new Error('Case-study images must be genuine portfolio proof and cannot be AI-regenerated.');\n  return [{ json: { postId: post.id, prompt: `Create a fresh premium editorial blog cover for a UK creative technology agency. Article: ${post.title}. Campaign: ${post.campaign || 'agency'}. Wide landscape, sophisticated and credible, charcoal/warm white/magenta palette, no logos, no readable text, no watermarks, no fake UI and no implication this is client portfolio work.`, alt: post.featuredImageAlt || `${post.title} AI-assisted editorial concept` } }];"
      },
