# Copy to .env and fill in real values. Never commit real secrets.

DATABASE_URL=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

AUTH_TRUST_HOST=true

# Used only by scripts/create-admin.ts. Choose a unique password of 12+ characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="WeTrends Admin"

N8N_API_KEY=""
N8N_ALLOWED_IPS=""

# PostHog analytics — same project across all client sites, differentiated by NEXT_PUBLIC_SITE_NAME.
# Region must match the PostHog project (EU vs US ingestion hosts differ).
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_api_key_here"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_UI_HOST="https://us.posthog.com"
# Unique per deployment — tags every event so dashboards can be filtered per client site.
NEXT_PUBLIC_SITE_NAME="wetrends"

# Google Search Console verification token (content value of the meta tag GSC gives you).
# Omit to skip emitting the meta tag.
GOOGLE_SITE_VERIFICATION=""

# Cloudinary — hosts the 18 vertical reels on /case-studies.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=l1uyp2mb
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional separate private Cloudinary environment for event galleries.
# This avoids moving the existing public case-study media.
EVENT_CLOUDINARY_CLOUD_NAME=""
EVENT_CLOUDINARY_API_KEY=""
EVENT_CLOUDINARY_API_SECRET=""

# Event commerce. Keep every secret server-side and use separate Stripe keys
# for preview/test and production environments.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
EVENT_LINK_SECRET=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="WeTrends <events@wetrends.co.uk>"
RESEND_REPLY_TO_EMAIL="events@wetrends.co.uk"
EVENT_TEST_EMAIL=""

# Private event storage in the company Google Workspace Shared Drive.
# The folder IDs are not secrets; credentials must stay server-side.
GOOGLE_DRIVE_SHARED_DRIVE_ID=""
GOOGLE_DRIVE_EVENTS_ROOT_FOLDER_ID=""
# Use either a service-account JSON object or the two separate values below.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
# Short-lived local development token only; do not use this in production.
GOOGLE_DRIVE_ACCESS_TOKEN=""
